<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.common.system.sys.i18n.mapper.SysI18nKeyMapper">

    <!--
        多语言-资源(sys_i18n_key)映射
        列清单与 V1_01_040__sys_i18n_schema.sql（分析报告附录 A 定稿）一致；
        key 仅随 resources/i18n/** 资源文件扫描产生（D5），无人工维护接口；
        (field_model, field_key) 业务唯一由代码层保证（联合索引 idx_i18n_key_model_key）。
    -->

    <resultMap id="SysI18nKeyResultMap" type="com.common.system.sys.i18n.model.SysI18nKey">
        <id column="field_id" property="fieldId"/>
        <result column="field_key" property="fieldKey"/>
        <result column="field_model" property="fieldModel"/>
    </resultMap>

    <sql id="BaseColumns">
        field_id, field_key, field_model
    </sql>

    <insert id="insert" parameterType="com.common.system.sys.i18n.model.SysI18nKey">
        INSERT INTO sys_i18n_key (
        field_id, field_key, field_model
        ) VALUES (
        #{model.fieldId}, #{model.fieldKey}, #{model.fieldModel}
        )
    </insert>

    <update id="update" parameterType="com.common.system.sys.i18n.model.SysI18nKey">
        UPDATE sys_i18n_key
        <set>
            <if test="model.fieldKey != null">field_key = #{model.fieldKey},</if>
            <if test="model.fieldModel != null">field_model = #{model.fieldModel},</if>
        </set>
        WHERE field_id = #{model.fieldId}
    </update>

    <delete id="deleteById" parameterType="string">
        DELETE FROM sys_i18n_key
        WHERE field_id = #{fieldId}
    </delete>

    <select id="selectById" parameterType="string" resultMap="SysI18nKeyResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_i18n_key
        WHERE field_id = #{fieldId}
    </select>

    <!-- 条件列表：资源项按模块 + key 过滤（无人工维护页面，仅同步与内部核查使用） -->
    <select id="selectList" resultMap="SysI18nKeyResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_i18n_key
        <where>
            <if test="model.fieldId != null and model.fieldId != ''">AND field_id = #{model.fieldId}</if>
            <if test="model.fieldModel != null and model.fieldModel != ''">AND field_model = #{model.fieldModel}</if>
            <if test="model.fieldKey != null and model.fieldKey != ''">AND field_key LIKE CONCAT('%', #{model.fieldKey}, '%')</if>
        </where>
        ORDER BY field_key ASC
        <if test="pages != null and pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 按 (field_model, field_key) 查询（同步幂等登记与导入校验用） -->
    <select id="selectByModelAndKey" resultMap="SysI18nKeyResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_i18n_key
        WHERE field_model = #{fieldModel}
          AND field_key = #{fieldKey}
        LIMIT 1
    </select>

    <!-- 指定模块的全部资源项（field_key 升序，翻译矩阵行序） -->
    <select id="selectByModel" resultMap="SysI18nKeyResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_i18n_key
        WHERE field_model = #{fieldModel}
        ORDER BY field_key ASC
    </select>

    <!-- 模块聚合：去重 field_model（按 field_model 升序），供翻译维护模块下拉 -->
    <select id="selectDistinctModels" resultType="string">
        SELECT DISTINCT field_model
        FROM sys_i18n_key
        ORDER BY field_model ASC
    </select>

    <!-- 按 (field_model, field_key) 统计（同步幂等判定） -->
    <select id="countByModelAndKey" resultType="long">
        SELECT COUNT(1)
        FROM sys_i18n_key
        WHERE field_model = #{fieldModel}
          AND field_key = #{fieldKey}
    </select>

    <!-- 轻量加载：本表无名称列，仅返回全列（先例 SysTaskHistoryMapper.loadModel） -->
    <select id="loadModel" parameterType="string" resultMap="SysI18nKeyResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_i18n_key
        WHERE field_id = #{fieldId}
    </select>

</mapper>
