<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eric.base.sys.datasource.mapper.SysDatasourceMapper">

<!--
    数据源表(sys_datasource)映射
    field_conditions / field_fields 为 JSON 列：存储态原文字符串（列表响应不解析），
    load 解析为对象由 Service 完成（F18-BE-004）；落库前由 Service 序列化为 JSON 字符串
    （禁止手工拼串，先例 sys_number_rule.field_rule）。
    依据 docs/v1_8-数据源/样例代码-日程数据源.md「§2.7 Mapper XML」，
    列清单与 V1_01_046__sys_datasource_schema.sql 保持一致。
    field_target 保存后锁定（D3 先例），update 不提供更新入口；
    /enable 通道走 updateEnable（仅更新 field_enable 与审计字段）。
-->

    <resultMap id="SysDatasourceResultMap" type="com.eric.base.sys.datasource.model.SysDatasource">
        <id column="field_id" property="fieldId"/>
        <result column="field_name" property="fieldName"/>
        <result column="field_code" property="fieldCode"/>
        <result column="field_creator_id" property="fieldCreatorId"/>
        <result column="field_create_time" property="fieldCreateTime"/>
        <result column="field_updater_id" property="fieldUpdaterId"/>
        <result column="field_update_time" property="fieldUpdateTime"/>
        <result column="field_enable" property="fieldEnable"/>
        <result column="field_target" property="fieldTarget"/>
        <result column="field_conditions" property="fieldConditions"/>
        <result column="field_fields" property="fieldFields"/>
        <result column="field_remark" property="fieldRemark"/>
    </resultMap>

    <sql id="BaseColumns">
        field_id, field_name, field_code, field_creator_id, field_create_time,
        field_updater_id, field_update_time, field_enable,
        field_target, field_conditions, field_fields, field_remark
    </sql>

    <!--
        管理列表查询条件：fieldName / fieldCode 模糊，fieldTarget / fieldEnable 精确；
        selectList 与 selectCount 共用本片段保证条件一致（供 metadata.total）
    -->
    <sql id="QueryConditions">
        <where>
            <if test="model.fieldName != null and model.fieldName != ''">AND field_name LIKE CONCAT('%', #{model.fieldName}, '%')</if>
            <if test="model.fieldCode != null and model.fieldCode != ''">AND field_code LIKE CONCAT('%', #{model.fieldCode}, '%')</if>
            <if test="model.fieldTarget != null and model.fieldTarget != ''">AND field_target = #{model.fieldTarget}</if>
            <if test="model.fieldEnable != null">AND field_enable = #{model.fieldEnable}</if>
        </where>
    </sql>

    <!-- field_conditions / field_fields 落库前由 Service 序列化为 JSON 字符串（F18-BE-004），此处按字符串写入 JSON 列 -->
    <insert id="insert" parameterType="com.eric.base.sys.datasource.model.SysDatasource">
        INSERT INTO sys_datasource (
        field_id, field_name, field_code, field_creator_id, field_create_time,
        field_updater_id, field_update_time, field_enable,
        field_target, field_conditions, field_fields, field_remark
        ) VALUES (
        #{model.fieldId}, #{model.fieldName}, #{model.fieldCode}, #{model.fieldCreatorId}, #{model.fieldCreateTime},
        #{model.fieldUpdaterId}, #{model.fieldUpdateTime}, #{model.fieldEnable},
        #{model.fieldTarget}, #{model.fieldConditions}, #{model.fieldFields}, #{model.fieldRemark}
        )
    </insert>

    <update id="update" parameterType="com.eric.base.sys.datasource.model.SysDatasource">
        UPDATE sys_datasource
        <set>
            <if test="model.fieldName != null">field_name = #{model.fieldName},</if>
            <if test="model.fieldCode != null">field_code = #{model.fieldCode},</if>
            <if test="model.fieldCreatorId != null">field_creator_id = #{model.fieldCreatorId},</if>
            <if test="model.fieldCreateTime != null">field_create_time = #{model.fieldCreateTime},</if>
            <if test="model.fieldUpdaterId != null">field_updater_id = #{model.fieldUpdaterId},</if>
            <if test="model.fieldUpdateTime != null">field_update_time = #{model.fieldUpdateTime},</if>
            <if test="model.fieldEnable != null">field_enable = #{model.fieldEnable},</if>
            <!-- field_target 保存后锁定（D3 先例），不提供更新入口 -->
            <if test="model.fieldConditions != null">field_conditions = #{model.fieldConditions},</if>
            <if test="model.fieldFields != null">field_fields = #{model.fieldFields},</if>
            <if test="model.fieldRemark != null">field_remark = #{model.fieldRemark},</if>
        </set>
        WHERE field_id = #{model.fieldId}
    </update>

    <!-- /enable 通道更新：仅更新 field_enable 与修改人/修改时间 -->
    <update id="updateEnable">
        UPDATE sys_datasource
        <set>
            field_enable = #{fieldEnable},
            field_updater_id = #{updaterId},
            field_update_time = #{updateTime},
        </set>
        WHERE field_id = #{fieldId}
    </update>

    <delete id="deleteById" parameterType="string">
        DELETE FROM sys_datasource
        WHERE field_id = #{fieldId}
    </delete>

    <select id="selectById" parameterType="string" resultMap="SysDatasourceResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_datasource
        WHERE field_id = #{fieldId}
    </select>

    <!--
        管理列表（F18-BE-003）：fieldName / fieldCode 模糊，fieldTarget / fieldEnable 精确；
        field_conditions / field_fields 原文返回不解析（列表页不解析 JSON，load 由 Service 解析）；
        排序固定创建时间降序；needPage=false 返回全部匹配结果
    -->
    <select id="selectList" resultMap="SysDatasourceResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_datasource
        <include refid="QueryConditions"/>
        ORDER BY field_create_time DESC
        <if test="pages != null and pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 管理列表总数：条件与 selectList 完全一致，供响应 metadata.total -->
    <select id="selectCount" resultType="long">
        SELECT COUNT(*)
        FROM sys_datasource
        <include refid="QueryConditions"/>
    </select>

    <!-- 轻量加载：仅返回 field_id 与 field_name -->
    <select id="loadModel" parameterType="string" resultMap="SysDatasourceResultMap">
        SELECT field_id, field_name
        FROM sys_datasource
        WHERE field_id = #{fieldId}
    </select>

    <!--
        编码查重 / 执行期解析：按编码取数据源（uk_datasource_code 全局唯一），
        供 Service 全局查重（含默认数据源占用集）与 /query 按 code 解析（F18-BE-004）
    -->
    <select id="selectByCode" parameterType="string" resultMap="SysDatasourceResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_datasource
        WHERE field_code = #{fieldCode}
        LIMIT 1
    </select>

</mapper>
