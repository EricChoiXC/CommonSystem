<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eric.base.sys.number.mapper.SysNumberRecordDetailMapper">

    <!--
        取号明细表(sys_number_record_detail)映射
        流水类表只增不改：应用侧只执行 insert；作废为例外更新（仅置 field_void_time /
        field_void_reason 两字段，不回退计数器，方案 §5.4），void 更新与明细筛选查询
        随 NB3-BE-005 补充；update/deleteById 仅为满足基础接口契约保留
        （先例 sys_task_history）。
        幂等查询（selectValidByScopeAndModel）随 NB2-BE-002 补充。
        列清单与 V1_01_044__sys_number_schema.sql 保持一致。
    -->

    <resultMap id="SysNumberRecordDetailResultMap" type="com.eric.base.sys.number.model.SysNumberRecordDetail">
        <id column="field_id" property="fieldId"/>
        <result column="field_scope_key" property="fieldScopeKey"/>
        <result column="field_period" property="fieldPeriod"/>
        <result column="field_serial_id" property="fieldSerialId"/>
        <result column="field_serial_no" property="fieldSerialNo"/>
        <result column="field_model_name" property="fieldModelName"/>
        <result column="field_model_id" property="fieldModelId"/>
        <result column="field_code" property="fieldCode"/>
        <result column="field_record_time" property="fieldRecordTime"/>
        <result column="field_creator_id" property="fieldCreatorId"/>
        <result column="field_void_time" property="fieldVoidTime"/>
        <result column="field_void_reason" property="fieldVoidReason"/>
    </resultMap>

    <sql id="BaseColumns">
        field_id, field_scope_key, field_period, field_serial_id, field_serial_no,
        field_model_name, field_model_id, field_code, field_record_time,
        field_creator_id, field_void_time, field_void_reason
    </sql>

    <insert id="insert" parameterType="com.eric.base.sys.number.model.SysNumberRecordDetail">
        INSERT INTO sys_number_record_detail (
        field_id, field_scope_key, field_period, field_serial_id, field_serial_no,
        field_model_name, field_model_id, field_code, field_record_time,
        field_creator_id, field_void_time, field_void_reason
        ) VALUES (
        #{model.fieldId}, #{model.fieldScopeKey}, #{model.fieldPeriod}, #{model.fieldSerialId}, #{model.fieldSerialNo},
        #{model.fieldModelName}, #{model.fieldModelId}, #{model.fieldCode}, #{model.fieldRecordTime},
        #{model.fieldCreatorId}, #{model.fieldVoidTime}, #{model.fieldVoidReason}
        )
    </insert>

    <!-- 流水类表只增不改：本语句仅为满足 IBaseMapper 契约保留（作废例外更新随 NB3-BE-005 补充） -->
    <update id="update" parameterType="com.eric.base.sys.number.model.SysNumberRecordDetail">
        UPDATE sys_number_record_detail
        <set>
            <if test="model.fieldScopeKey != null">field_scope_key = #{model.fieldScopeKey},</if>
            <if test="model.fieldPeriod != null">field_period = #{model.fieldPeriod},</if>
            <if test="model.fieldSerialId != null">field_serial_id = #{model.fieldSerialId},</if>
            <if test="model.fieldSerialNo != null">field_serial_no = #{model.fieldSerialNo},</if>
            <if test="model.fieldModelName != null">field_model_name = #{model.fieldModelName},</if>
            <if test="model.fieldModelId != null">field_model_id = #{model.fieldModelId},</if>
            <if test="model.fieldCode != null">field_code = #{model.fieldCode},</if>
            <if test="model.fieldRecordTime != null">field_record_time = #{model.fieldRecordTime},</if>
            <if test="model.fieldCreatorId != null">field_creator_id = #{model.fieldCreatorId},</if>
            <if test="model.fieldVoidTime != null">field_void_time = #{model.fieldVoidTime},</if>
            <if test="model.fieldVoidReason != null">field_void_reason = #{model.fieldVoidReason},</if>
        </set>
        WHERE field_id = #{model.fieldId}
    </update>

    <!-- 流水类表只增不改：本语句仅为满足 IBaseMapper 契约保留，业务不应调用 -->
    <delete id="deleteById" parameterType="string">
        DELETE FROM sys_number_record_detail
        WHERE field_id = #{fieldId}
    </delete>

    <select id="selectById" parameterType="string" resultMap="SysNumberRecordDetailResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_record_detail
        WHERE field_id = #{fieldId}
    </select>

    <select id="selectList" resultMap="SysNumberRecordDetailResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_record_detail
        <where>
            <if test="model.fieldId != null and model.fieldId != ''">AND field_id = #{model.fieldId}</if>
            <if test="model.fieldScopeKey != null and model.fieldScopeKey != ''">AND field_scope_key = #{model.fieldScopeKey}</if>
            <if test="model.fieldPeriod != null and model.fieldPeriod != ''">AND field_period = #{model.fieldPeriod}</if>
            <if test="model.fieldSerialId != null and model.fieldSerialId != ''">AND field_serial_id = #{model.fieldSerialId}</if>
            <if test="model.fieldModelName != null and model.fieldModelName != ''">AND field_model_name = #{model.fieldModelName}</if>
            <if test="model.fieldModelId != null and model.fieldModelId != ''">AND field_model_id = #{model.fieldModelId}</if>
            <if test="model.fieldCode != null and model.fieldCode != ''">AND field_code = #{model.fieldCode}</if>
        </where>
        ORDER BY field_record_time DESC
        <if test="pages != null and pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 轻量加载：本表无名称列，返回 id 与完整编号（field_code）及作用域标识 -->
    <select id="loadModel" parameterType="string" resultMap="SysNumberRecordDetailResultMap">
        SELECT field_id, field_scope_key, field_period, field_serial_id, field_serial_no, field_code
        FROM sys_number_record_detail
        WHERE field_id = #{fieldId}
    </select>

    <!--
        幂等查询（NB2-BE-002，方案 §5.3）：按作用域 + 业务单据ID 查未作废明细，
        命中直接返回原编号（reused=true）不推进计数器；
        同单据补号（reissue 顺延）后存在多条明细，取最近一条（reused 命中即补号后编号）；
        走 idx_number_record_detail_model 索引。
        lockForUpdate=true 追加 FOR UPDATE 锁定读（当前读，可见最新提交）：
        供计数器行锁等待后的幂等二次确认，命中即抛错回滚；false 为普通读幂等预检。
    -->
    <select id="selectValidByScopeAndModel" resultMap="SysNumberRecordDetailResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_record_detail
        WHERE field_scope_key = #{fieldScopeKey}
          AND field_model_id = #{fieldModelId}
          AND field_void_time IS NULL
        ORDER BY field_record_time DESC
        LIMIT 1
        <if test="lockForUpdate">FOR UPDATE</if>
    </select>

    <!--
        删除保护计数（NB3-BE-002，D9）：按作用域键统计取号明细行数（含已作废，取号痕迹保留）。
        明细表无 field_rule_id 列，固定接入作用域 = 规则 field_id（方案 §5.1）；
        计数 > 0 时规则拒绝删除（CRM_NUMBER_RULE_IN_USE），仅可停用。
    -->
    <select id="countByScopeKey" resultType="long">
        SELECT COUNT(*)
        FROM sys_number_record_detail
        WHERE field_scope_key = #{fieldScopeKey}
    </select>

    <!--
        取号明细列表查询条件（NB3-BE-005，方案 §3.2 manage/recordList）：
        fieldScopeKey 精确（服务端已把 fieldRuleId 翻译为作用域键——明细表无 field_rule_id 列，
        固定接入作用域即规则 field_id）；fieldPeriod 精确；voidFlag 三态（true 仅已作废 /
        false 仅未作废 / null 不过滤）；recordTimeBegin / recordTimeEnd 取号时间范围（含边界）；
        列表与计数共用本片段保证条件一致。
    -->
    <sql id="ManageQueryConditions">
        <where>
            <if test="query.fieldScopeKey != null and query.fieldScopeKey != ''">AND field_scope_key = #{query.fieldScopeKey}</if>
            <if test="query.fieldPeriod != null and query.fieldPeriod != ''">AND field_period = #{query.fieldPeriod}</if>
            <if test="query.voidFlag != null and query.voidFlag">AND field_void_time IS NOT NULL</if>
            <if test="query.voidFlag != null and !query.voidFlag">AND field_void_time IS NULL</if>
            <if test="query.recordTimeBegin != null">AND field_record_time &gt;= #{query.recordTimeBegin}</if>
            <if test="query.recordTimeEnd != null">AND field_record_time &lt;= #{query.recordTimeEnd}</if>
        </where>
    </sql>

    <!--
        取号明细列表查询（NB3-BE-005，方案 §3.2 manage/recordList）：条件见 ManageQueryConditions，
        排序固定取号时间降序；needPage=false 返回全部匹配结果。
    -->
    <select id="selectQueryList" resultMap="SysNumberRecordDetailResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_record_detail
        <include refid="ManageQueryConditions"/>
        ORDER BY field_record_time DESC
        <if test="pages != null and pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 取号明细列表总数（NB3-BE-005）：条件与 selectQueryList 完全一致，供响应 metadata.total -->
    <select id="countQueryList" resultType="long">
        SELECT COUNT(*)
        FROM sys_number_record_detail
        <include refid="ManageQueryConditions"/>
    </select>

    <!--
        作废取号明细（NB3-BE-005，方案 §5.4 void / D8 唯一例外更新）：仅置 field_void_time /
        field_void_reason 两字段，不回退计数器（避免重号），不改任何业务字段；
        field_void_time IS NULL 守卫保证已作废明细不再重复更新（幂等语义由 Service 先检）。
    -->
    <update id="updateVoid">
        UPDATE sys_number_record_detail
        SET field_void_time = #{fieldVoidTime},
            field_void_reason = #{fieldVoidReason}
        WHERE field_id = #{fieldId}
          AND field_void_time IS NULL
    </update>

</mapper>
