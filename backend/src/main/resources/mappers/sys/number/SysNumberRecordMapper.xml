<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eric.base.sys.number.mapper.SysNumberRecordMapper">

    <!--
        取号计数表(sys_number_record)映射
        流水类表只增不改：应用侧只执行 insert（uk_number_record_scope 定位行）；
        update/deleteById 仅为满足基础接口契约保留（先例 sys_task_history）。
        周期切换封存（置 field_record_finish_time）与计数器原子 upsert
        （INSERT ... ON DUPLICATE KEY UPDATE field_serial_no = LAST_INSERT_ID(field_serial_no + 1)）
        随 NB2-BE-002 补充。
        列清单与 V1_01_044__sys_number_schema.sql 保持一致。
    -->

    <resultMap id="SysNumberRecordResultMap" type="com.eric.base.sys.number.model.SysNumberRecord">
        <id column="field_id" property="fieldId"/>
        <result column="field_rule_id" property="fieldRuleId"/>
        <result column="field_scope_key" property="fieldScopeKey"/>
        <result column="field_serial_id" property="fieldSerialId"/>
        <result column="field_period" property="fieldPeriod"/>
        <result column="field_serial_no" property="fieldSerialNo"/>
        <result column="field_record_time" property="fieldRecordTime"/>
        <result column="field_record_finish_time" property="fieldRecordFinishTime"/>
    </resultMap>

    <sql id="BaseColumns">
        field_id, field_rule_id, field_scope_key, field_serial_id, field_period,
        field_serial_no, field_record_time, field_record_finish_time
    </sql>

    <insert id="insert" parameterType="com.eric.base.sys.number.model.SysNumberRecord">
        INSERT INTO sys_number_record (
        field_id, field_rule_id, field_scope_key, field_serial_id, field_period,
        field_serial_no, field_record_time, field_record_finish_time
        ) VALUES (
        #{model.fieldId}, #{model.fieldRuleId}, #{model.fieldScopeKey}, #{model.fieldSerialId}, #{model.fieldPeriod},
        #{model.fieldSerialNo}, #{model.fieldRecordTime}, #{model.fieldRecordFinishTime}
        )
    </insert>

    <!-- 流水类表只增不改：本语句仅为满足 IBaseMapper 契约保留，业务不应调用 -->
    <update id="update" parameterType="com.eric.base.sys.number.model.SysNumberRecord">
        UPDATE sys_number_record
        <set>
            <if test="model.fieldRuleId != null">field_rule_id = #{model.fieldRuleId},</if>
            <if test="model.fieldScopeKey != null">field_scope_key = #{model.fieldScopeKey},</if>
            <if test="model.fieldSerialId != null">field_serial_id = #{model.fieldSerialId},</if>
            <if test="model.fieldPeriod != null">field_period = #{model.fieldPeriod},</if>
            <if test="model.fieldSerialNo != null">field_serial_no = #{model.fieldSerialNo},</if>
            <if test="model.fieldRecordTime != null">field_record_time = #{model.fieldRecordTime},</if>
            <if test="model.fieldRecordFinishTime != null">field_record_finish_time = #{model.fieldRecordFinishTime},</if>
        </set>
        WHERE field_id = #{model.fieldId}
    </update>

    <!-- 流水类表只增不改：本语句仅为满足 IBaseMapper 契约保留，业务不应调用 -->
    <delete id="deleteById" parameterType="string">
        DELETE FROM sys_number_record
        WHERE field_id = #{fieldId}
    </delete>

    <select id="selectById" parameterType="string" resultMap="SysNumberRecordResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_record
        WHERE field_id = #{fieldId}
    </select>

    <select id="selectList" resultMap="SysNumberRecordResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_record
        <where>
            <if test="model.fieldId != null and model.fieldId != ''">AND field_id = #{model.fieldId}</if>
            <if test="model.fieldRuleId != null and model.fieldRuleId != ''">AND field_rule_id = #{model.fieldRuleId}</if>
            <if test="model.fieldScopeKey != null and model.fieldScopeKey != ''">AND field_scope_key = #{model.fieldScopeKey}</if>
            <if test="model.fieldSerialId != null and model.fieldSerialId != ''">AND field_serial_id = #{model.fieldSerialId}</if>
            <if test="model.fieldPeriod != null and model.fieldPeriod != ''">AND field_period = #{model.fieldPeriod}</if>
        </where>
        ORDER BY field_record_time DESC
        <if test="pages != null and pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 轻量加载：本表无名称列，返回 id 与作用域标识（field_scope_key / field_serial_id / field_period） -->
    <select id="loadModel" parameterType="string" resultMap="SysNumberRecordResultMap">
        SELECT field_id, field_scope_key, field_serial_id, field_period
        FROM sys_number_record
        WHERE field_id = #{fieldId}
    </select>

</mapper>
