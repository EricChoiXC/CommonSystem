<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eric.base.sys.number.mapper.SysNumberRuleMapper">

<!--
    编号规则表(sys_number_rule)映射
    field_rule 为 JSON 列：存储态原文字符串（列表响应不解析），
    load 解析为 SysNumberRuleConfigDo 由 Service 完成（NB3-BE-002）。
    依据 docs/v1_5-编号功能/编号机制实现方案.md「§核心表和字段」，
    列清单与 V1_01_044__sys_number_schema.sql 保持一致。
    失效接入项告警查询（selectDistinctModelIds）随 NB2-BE-001 补充；
    固定接入取号定位（selectByModel）随 NB2-BE-002 补充；
    切换启用（同事务停用同接入项原启用规则）等业务 SQL 随 NB3-BE-002 补充。
-->

    <resultMap id="SysNumberRuleResultMap" type="com.eric.base.sys.number.model.SysNumberRule">
        <id column="field_id" property="fieldId"/>
        <result column="field_name" property="fieldName"/>
        <result column="field_code" property="fieldCode"/>
        <result column="field_creator_id" property="fieldCreatorId"/>
        <result column="field_create_time" property="fieldCreateTime"/>
        <result column="field_updater_id" property="fieldUpdaterId"/>
        <result column="field_update_time" property="fieldUpdateTime"/>
        <result column="field_enable" property="fieldEnable"/>
        <result column="field_rule" property="fieldRule"/>
        <result column="field_model_id" property="fieldModelId"/>
        <result column="field_model_name" property="fieldModelName"/>
        <result column="field_model_field" property="fieldModelField"/>
    </resultMap>

    <sql id="BaseColumns">
        field_id, field_name, field_code, field_creator_id, field_create_time,
        field_updater_id, field_update_time, field_enable,
        field_rule, field_model_id, field_model_name, field_model_field
    </sql>

    <!-- field_rule 落库前由 Service 序列化为 JSON 字符串（NB3-BE-002），此处按字符串写入 JSON 列 -->
    <insert id="insert" parameterType="com.eric.base.sys.number.model.SysNumberRule">
        INSERT INTO sys_number_rule (
        field_id, field_name, field_code, field_creator_id, field_create_time,
        field_updater_id, field_update_time, field_enable,
        field_rule, field_model_id, field_model_name, field_model_field
        ) VALUES (
        #{model.fieldId}, #{model.fieldName}, #{model.fieldCode}, #{model.fieldCreatorId}, #{model.fieldCreateTime},
        #{model.fieldUpdaterId}, #{model.fieldUpdateTime}, #{model.fieldEnable},
        #{model.fieldRule}, #{model.fieldModelId}, #{model.fieldModelName}, #{model.fieldModelField}
        )
    </insert>

    <update id="update" parameterType="com.eric.base.sys.number.model.SysNumberRule">
        UPDATE sys_number_rule
        <set>
            <if test="model.fieldName != null">field_name = #{model.fieldName},</if>
            <if test="model.fieldCode != null">field_code = #{model.fieldCode},</if>
            <if test="model.fieldCreatorId != null">field_creator_id = #{model.fieldCreatorId},</if>
            <if test="model.fieldCreateTime != null">field_create_time = #{model.fieldCreateTime},</if>
            <if test="model.fieldUpdaterId != null">field_updater_id = #{model.fieldUpdaterId},</if>
            <if test="model.fieldUpdateTime != null">field_update_time = #{model.fieldUpdateTime},</if>
            <if test="model.fieldEnable != null">field_enable = #{model.fieldEnable},</if>
            <!-- field_model_id 保存后锁定（D3），不提供更新入口 -->
            <if test="model.fieldRule != null">field_rule = #{model.fieldRule},</if>
            <if test="model.fieldModelName != null">field_model_name = #{model.fieldModelName},</if>
            <if test="model.fieldModelField != null">field_model_field = #{model.fieldModelField},</if>
        </set>
        WHERE field_id = #{model.fieldId}
    </update>

    <delete id="deleteById" parameterType="string">
        DELETE FROM sys_number_rule
        WHERE field_id = #{fieldId}
    </delete>

    <select id="selectById" parameterType="string" resultMap="SysNumberRuleResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_rule
        WHERE field_id = #{fieldId}
    </select>

    <select id="selectList" resultMap="SysNumberRuleResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_rule
        <where>
            <if test="model.fieldId != null and model.fieldId != ''">AND field_id = #{model.fieldId}</if>
            <if test="model.fieldCode != null and model.fieldCode != ''">AND field_code = #{model.fieldCode}</if>
            <if test="model.fieldName != null and model.fieldName != ''">AND field_name LIKE CONCAT('%', #{model.fieldName}, '%')</if>
            <if test="model.fieldModelId != null and model.fieldModelId != ''">AND field_model_id = #{model.fieldModelId}</if>
            <if test="model.fieldEnable != null">AND field_enable = #{model.fieldEnable}</if>
        </where>
        ORDER BY field_create_time DESC
        <if test="pages != null and pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 轻量加载：仅返回 field_id 与 field_name -->
    <select id="loadModel" parameterType="string" resultMap="SysNumberRuleResultMap">
        SELECT field_id, field_name
        FROM sys_number_rule
        WHERE field_id = #{fieldId}
    </select>

    <!-- 失效接入项告警查询（NB2-BE-001 启动任务）：全部规则引用的接入项编码去重清单，
         与 numberRule.yml 接入项缓存比对，缺失项输出告警日志（R6，不阻断启动） -->
    <select id="selectDistinctModelIds" resultType="string">
        SELECT DISTINCT field_model_id
        FROM sys_number_rule
        WHERE field_model_id IS NOT NULL AND field_model_id != ''
    </select>

    <!--
        固定接入取号定位（NB2-BE-002，方案 §5.1/§5.3）：按接入项（模型名 + 字段）取规则清单，
        取号事务内由此区分「无规则（CRM_NUMBER_RULE_NOT_FOUND）」与
        「无启用规则（CRM_NUMBER_RULE_DISABLED）」；同接入项启用规则唯一由
        save/enable 切换机制保证（D1），走 idx_number_rule_model 索引。
    -->
    <select id="selectByModel" resultMap="SysNumberRuleResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_rule
        WHERE field_model_name = #{fieldModelName}
          AND field_model_field = #{fieldModelField}
        ORDER BY field_create_time DESC
    </select>

    <!--
        规则列表查询条件（NB3-BE-002，方案 §3.2 rule/list）：fieldName / fieldCode 模糊，
        fieldModelId / fieldModelField 精确，fieldEnable 精确；列表与计数共用本片段保证条件一致
    -->
    <sql id="QueryConditions">
        <where>
            <if test="query.fieldName != null and query.fieldName != ''">AND field_name LIKE CONCAT('%', #{query.fieldName}, '%')</if>
            <if test="query.fieldCode != null and query.fieldCode != ''">AND field_code LIKE CONCAT('%', #{query.fieldCode}, '%')</if>
            <if test="query.fieldModelId != null and query.fieldModelId != ''">AND field_model_id = #{query.fieldModelId}</if>
            <if test="query.fieldModelField != null and query.fieldModelField != ''">AND field_model_field = #{query.fieldModelField}</if>
            <if test="query.fieldEnable != null">AND field_enable = #{query.fieldEnable}</if>
        </where>
    </sql>

    <!--
        规则列表查询（NB3-BE-002，方案 §3.2 rule/list）：field_rule 原文返回不解析（A4，
        列表页不解析 JSON，load 由 Service 解析），排序固定创建时间降序；
        needPage=false 返回全部匹配结果
    -->
    <select id="selectQueryList" resultMap="SysNumberRuleResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_rule
        <include refid="QueryConditions"/>
        ORDER BY field_create_time DESC
        <if test="pages != null and pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 规则列表总数（NB3-BE-002）：条件与 selectQueryList 完全一致，供响应 metadata.total -->
    <select id="countQueryList" resultType="long">
        SELECT COUNT(*)
        FROM sys_number_rule
        <include refid="QueryConditions"/>
    </select>

    <!-- 规则编码查重（NB3-BE-002，D4，Service 层校验先例 i18n 语言码）：同编码仅允许一条 -->
    <select id="selectByCode" parameterType="string" resultMap="SysNumberRuleResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_number_rule
        WHERE field_code = #{fieldCode}
        LIMIT 1
    </select>

    <!--
        同接入项启用规则计数（NB3-BE-002，R2 收尾自检）：save / enable 切换启用后
        该计数应恰为 1（D1「同接入项至多一条启用」不变式），不符抛 IllegalStateException 令事务回滚
    -->
    <select id="countEnabledByModel" resultType="long">
        SELECT COUNT(*)
        FROM sys_number_rule
        WHERE field_model_id = #{fieldModelId}
          AND field_enable = b'1'
    </select>

    <!--
        切换启用（NB3-BE-002，D1）：停用同接入项下其他已启用规则（排除本次启用/新建的规则自身），
        与自身置启用同事务执行；同步更新审计字段（对齐 updateEnable 先例）
    -->
    <update id="disableOtherEnabledByModel">
        UPDATE sys_number_rule
        SET field_enable = b'0',
            field_updater_id = #{updaterId},
            field_update_time = #{updateTime}
        WHERE field_model_id = #{fieldModelId}
          AND field_enable = b'1'
          AND field_id != #{excludeFieldId}
    </update>

</mapper>
