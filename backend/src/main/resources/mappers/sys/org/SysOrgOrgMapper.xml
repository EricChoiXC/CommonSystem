<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eric.base.sys.org.mapper.SysOrgOrgMapper">

    <!--
        机构扩展表(sys_org_org)映射
        本表仅承载机构扩展字段，公共字段与层级字段存储在 sys_org_element 主表中
        (field_org_type = 1)，通过 field_id 一对一关联，由 Service 层组装；
        SysOrgOrg.fieldLeaderId 关联 sys_org_user.field_id，本表不做 JOIN，由 Service 层组装。
        列清单与 artificial/docs/设计文档/sys/org/组织架构表结构.md 保持一致。
    -->

    <resultMap id="SysOrgOrgResultMap" type="com.eric.base.sys.org.model.SysOrgOrg">
        <id column="field_id" property="fieldId"/>
        <result column="field_leader_id" property="fieldLeaderId"/>
        <result column="field_phone" property="fieldPhone"/>
        <result column="field_email" property="fieldEmail"/>
        <result column="field_address" property="fieldAddress"/>
    </resultMap>

    <sql id="BaseColumns">
        field_id, field_leader_id, field_phone, field_email, field_address
    </sql>

    <insert id="insert" parameterType="com.eric.base.sys.org.model.SysOrgOrg">
        INSERT INTO sys_org_org (
        <include refid="BaseColumns"/>
        ) VALUES (
        #{model.fieldId}, #{model.fieldLeaderId}, #{model.fieldPhone}, #{model.fieldEmail}, #{model.fieldAddress}
        )
    </insert>

    <update id="update" parameterType="com.eric.base.sys.org.model.SysOrgOrg">
        UPDATE sys_org_org
        <set>
            <if test="model.fieldLeaderId != null">field_leader_id = #{model.fieldLeaderId},</if>
            <if test="model.fieldPhone != null">field_phone = #{model.fieldPhone},</if>
            <if test="model.fieldEmail != null">field_email = #{model.fieldEmail},</if>
            <if test="model.fieldAddress != null">field_address = #{model.fieldAddress},</if>
        </set>
        WHERE field_id = #{model.fieldId}
    </update>

    <delete id="deleteById" parameterType="string">
        DELETE FROM sys_org_org
        WHERE field_id = #{fieldId}
    </delete>

    <select id="selectById" parameterType="string" resultMap="SysOrgOrgResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_org_org
        WHERE field_id = #{fieldId}
    </select>

    <select id="selectList" resultMap="SysOrgOrgResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_org_org
        <where>
            <if test="model.fieldId != null and model.fieldId != ''">AND field_id = #{model.fieldId}</if>
            <if test="model.fieldLeaderId != null and model.fieldLeaderId != ''">AND field_leader_id = #{model.fieldLeaderId}</if>
            <if test="model.fieldPhone != null and model.fieldPhone != ''">AND field_phone LIKE CONCAT('%', #{model.fieldPhone}, '%')</if>
            <if test="model.fieldEmail != null and model.fieldEmail != ''">AND field_email LIKE CONCAT('%', #{model.fieldEmail}, '%')</if>
        </where>
        ORDER BY field_id
        <if test="pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!--
        轻量加载：仅返回 field_id 与 field_name，供关联对象(如 SysOrgElement.fieldParent)赋值使用；
        field_name 不在本扩展表，JOIN sys_org_element 主表获取
    -->
    <resultMap id="SysOrgOrgLoadResultMap" type="com.eric.base.sys.org.model.SysOrgOrg">
        <id column="field_id" property="fieldId"/>
        <result column="field_name" property="fieldName"/>
    </resultMap>

    <select id="loadModel" parameterType="string" resultMap="SysOrgOrgLoadResultMap">
        SELECT e.field_id, e.field_name
        FROM sys_org_org o
        INNER JOIN sys_org_element e ON e.field_id = o.field_id
        WHERE o.field_id = #{fieldId}
    </select>

</mapper>
