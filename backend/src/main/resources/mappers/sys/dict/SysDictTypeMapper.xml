<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eric.base.sys.dict.mapper.SysDictTypeMapper">

    <!--
        码值类型(sys_dict_type)映射
        字段命名遵循公共字段规范(field_ 前缀)，与 Java 属性直接 camel-case 对应；
        类型列表固定按 field_code 升序展示，不可维护。
        列清单与 artificial/docs/设计文档/sys/dict/码值功能核心业务.md 保持一致。
    -->

    <resultMap id="SysDictTypeResultMap" type="com.eric.base.sys.dict.model.SysDictType">
        <id column="field_id" property="fieldId"/>
        <result column="field_code" property="fieldCode"/>
        <result column="field_name" property="fieldName"/>
        <result column="field_desc" property="fieldDesc"/>
        <result column="field_enable" property="fieldEnable"/>
    </resultMap>

    <sql id="BaseColumns">
        field_id, field_code, field_name, field_desc, field_enable
    </sql>

    <insert id="insert" parameterType="com.eric.base.sys.dict.model.SysDictType">
        INSERT INTO sys_dict_type (
        field_id, field_code, field_name, field_desc, field_enable
        ) VALUES (
        #{model.fieldId}, #{model.fieldCode}, #{model.fieldName}, #{model.fieldDesc}, #{model.fieldEnable}
        )
    </insert>

    <update id="update" parameterType="com.eric.base.sys.dict.model.SysDictType">
        UPDATE sys_dict_type
        <set>
            <if test="model.fieldCode != null">field_code = #{model.fieldCode},</if>
            <if test="model.fieldName != null">field_name = #{model.fieldName},</if>
            <if test="model.fieldDesc != null">field_desc = #{model.fieldDesc},</if>
            <if test="model.fieldEnable != null">field_enable = #{model.fieldEnable},</if>
        </set>
        WHERE field_id = #{model.fieldId}
    </update>

    <delete id="deleteById" parameterType="string">
        DELETE FROM sys_dict_type
        WHERE field_id = #{fieldId}
    </delete>

    <select id="selectById" parameterType="string" resultMap="SysDictTypeResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_dict_type
        WHERE field_id = #{fieldId}
    </select>

    <select id="selectList" resultMap="SysDictTypeResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_dict_type
        <where>
            <if test="model.fieldId != null and model.fieldId != ''">AND field_id = #{model.fieldId}</if>
            <if test="model.fieldCode != null and model.fieldCode != ''">AND field_code LIKE CONCAT('%', #{model.fieldCode}, '%')</if>
            <if test="model.fieldName != null and model.fieldName != ''">AND field_name LIKE CONCAT('%', #{model.fieldName}, '%')</if>
            <if test="model.fieldEnable != null">AND field_enable = #{model.fieldEnable}</if>
        </where>
        ORDER BY field_code ASC
        <if test="pages != null and pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 全部码值类型（按 field_code 升序），供左侧类型列表展示（前端按关键字过滤） -->
    <select id="selectAll" resultMap="SysDictTypeResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_dict_type
        ORDER BY field_code ASC
    </select>

    <!-- 按编号查询码值类型（启动增量导入与 items 使用接口） -->
    <select id="selectByCode" parameterType="string" resultMap="SysDictTypeResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_dict_type
        WHERE field_code = #{fieldCode}
    </select>

    <!-- 轻量加载：仅返回 field_id 与 field_name，供关联对象赋值使用 -->
    <resultMap id="SysDictTypeLoadResultMap" type="com.eric.base.sys.dict.model.SysDictType">
        <id column="field_id" property="fieldId"/>
        <result column="field_name" property="fieldName"/>
    </resultMap>

    <select id="loadModel" parameterType="string" resultMap="SysDictTypeLoadResultMap">
        SELECT field_id, field_name
        FROM sys_dict_type
        WHERE field_id = #{fieldId}
    </select>

</mapper>
