<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.common.system.sys.process.mapper.SysProcessTemplateHistoryMapper">

    <!--
        流程模板历史版本表(sys_process_template_history)映射
        field_content 以 JSON 字符串保存归档时刻的模板与全部节点信息；流水只增不改。
    -->

    <resultMap id="SysProcessTemplateHistoryResultMap" type="com.common.system.sys.process.model.SysProcessTemplateHistory">
        <id column="field_id" property="fieldId"/>
        <result column="field_template_id" property="fieldTemplateId"/>
        <result column="field_version" property="fieldVersion"/>
        <result column="field_content" property="fieldContent"/>
    </resultMap>

    <sql id="BaseColumns">
        field_id, field_template_id, field_version, field_content
    </sql>

    <insert id="insert" parameterType="com.common.system.sys.process.model.SysProcessTemplateHistory">
        INSERT INTO sys_process_template_history (
        <include refid="BaseColumns"/>
        ) VALUES (
        #{model.fieldId}, #{model.fieldTemplateId}, #{model.fieldVersion}, #{model.fieldContent}
        )
    </insert>

    <update id="update" parameterType="com.common.system.sys.process.model.SysProcessTemplateHistory">
        UPDATE sys_process_template_history
        <set>
            <if test="model.fieldTemplateId != null">field_template_id = #{model.fieldTemplateId},</if>
            <if test="model.fieldVersion != null">field_version = #{model.fieldVersion},</if>
            <if test="model.fieldContent != null">field_content = #{model.fieldContent},</if>
        </set>
        WHERE field_id = #{model.fieldId}
    </update>

    <delete id="deleteById" parameterType="string">
        DELETE FROM sys_process_template_history
        WHERE field_id = #{fieldId}
    </delete>

    <select id="selectById" parameterType="string" resultMap="SysProcessTemplateHistoryResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_process_template_history
        WHERE field_id = #{fieldId}
    </select>

    <select id="selectList" resultMap="SysProcessTemplateHistoryResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_process_template_history
        <where>
            <if test="model.fieldId != null and model.fieldId != ''">AND field_id = #{model.fieldId}</if>
            <if test="model.fieldTemplateId != null and model.fieldTemplateId != ''">AND field_template_id = #{model.fieldTemplateId}</if>
        </where>
        ORDER BY field_version ASC
    </select>

    <!-- 轻量加载：仅返回 field_id 与 field_name（历史记录无名称，回退模板id），供关联对象赋值使用 -->
    <resultMap id="SysProcessTemplateHistoryLoadResultMap" type="com.common.system.sys.process.model.SysProcessTemplateHistory">
        <id column="field_id" property="fieldId"/>
        <result column="field_template_id" property="fieldTemplateId"/>
    </resultMap>

    <select id="loadModel" parameterType="string" resultMap="SysProcessTemplateHistoryLoadResultMap">
        SELECT field_id, field_template_id
        FROM sys_process_template_history
        WHERE field_id = #{fieldId}
    </select>

    <!-- 按模板查询历史版本（按版本号升序） -->
    <select id="selectListByTemplateId" parameterType="string" resultMap="SysProcessTemplateHistoryResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_process_template_history
        WHERE field_template_id = #{templateId}
        ORDER BY field_version ASC
    </select>

</mapper>
