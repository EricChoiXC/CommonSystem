<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eric.base.sys.log.mapper.SysLogOperationMapper">

    <!--
        通用日志表(sys_log_operation)映射
        流水表只增不改：仅提供 insert / insertBatch / select*，不提供 update / delete。
        列清单与 artificial/docs/设计文档/sys/log/日志表结构.md 保持一致；
        操作人姓名(field_user_name)为写入时的快照，查询不联表。
    -->

    <resultMap id="SysLogOperationResultMap" type="com.eric.base.sys.log.model.SysLogOperation">
        <id column="field_id" property="fieldId"/>
        <result column="field_log_type" property="fieldLogType"/>
        <result column="field_user_id" property="fieldUserId"/>
        <result column="field_user_name" property="fieldUserName"/>
        <result column="field_login_name" property="fieldLoginName"/>
        <result column="field_module" property="fieldModule"/>
        <result column="field_action" property="fieldAction"/>
        <result column="field_business_id" property="fieldBusinessId"/>
        <result column="field_before" property="fieldBefore"/>
        <result column="field_after" property="fieldAfter"/>
        <result column="field_remark" property="fieldRemark"/>
        <result column="field_ip" property="fieldIp"/>
        <result column="field_user_agent" property="fieldUserAgent"/>
        <result column="field_result" property="fieldResult"/>
        <result column="field_fail_reason" property="fieldFailReason"/>
        <result column="field_operate_time" property="fieldOperateTime"/>
    </resultMap>

    <sql id="BaseColumns">
        field_id, field_log_type, field_user_id, field_user_name, field_login_name,
        field_module, field_action, field_business_id, field_before, field_after,
        field_remark, field_ip, field_user_agent, field_result, field_fail_reason,
        field_operate_time
    </sql>

    <sql id="LogWhere">
        <where>
            <if test="model.fieldLogType != null and model.fieldLogType != ''">AND field_log_type = #{model.fieldLogType}</if>
            <if test="model.fieldModule != null and model.fieldModule != ''">AND field_module = #{model.fieldModule}</if>
            <if test="model.fieldAction != null and model.fieldAction != ''">AND field_action = #{model.fieldAction}</if>
            <if test="model.fieldUserName != null and model.fieldUserName != ''">AND field_user_name LIKE CONCAT('%', #{model.fieldUserName}, '%')</if>
            <if test="model.fieldLoginName != null and model.fieldLoginName != ''">AND field_login_name LIKE CONCAT('%', #{model.fieldLoginName}, '%')</if>
            <if test="model.fieldBusinessId != null and model.fieldBusinessId != ''">AND field_business_id = #{model.fieldBusinessId}</if>
            <if test="model.fieldResult != null and model.fieldResult != ''">AND field_result = #{model.fieldResult}</if>
            <if test="operateTimeStart != null and operateTimeStart != ''">AND field_operate_time &gt;= #{operateTimeStart}</if>
            <if test="operateTimeEnd != null and operateTimeEnd != ''">AND field_operate_time &lt;= #{operateTimeEnd}</if>
        </where>
    </sql>

    <insert id="insert" parameterType="com.eric.base.sys.log.model.SysLogOperation">
        INSERT INTO sys_log_operation (
        field_id, field_log_type, field_user_id, field_user_name, field_login_name,
        field_module, field_action, field_business_id, field_before, field_after,
        field_remark, field_ip, field_user_agent, field_result, field_fail_reason,
        field_operate_time
        ) VALUES (
        #{model.fieldId}, #{model.fieldLogType}, #{model.fieldUserId}, #{model.fieldUserName}, #{model.fieldLoginName},
        #{model.fieldModule}, #{model.fieldAction}, #{model.fieldBusinessId}, #{model.fieldBefore}, #{model.fieldAfter},
        #{model.fieldRemark}, #{model.fieldIp}, #{model.fieldUserAgent}, #{model.fieldResult}, #{model.fieldFailReason},
        #{model.fieldOperateTime}
        )
    </insert>

    <!-- 批量插入：日志批量异步落库 -->
    <insert id="insertBatch">
        INSERT INTO sys_log_operation (
        field_id, field_log_type, field_user_id, field_user_name, field_login_name,
        field_module, field_action, field_business_id, field_before, field_after,
        field_remark, field_ip, field_user_agent, field_result, field_fail_reason,
        field_operate_time
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.fieldId}, #{item.fieldLogType}, #{item.fieldUserId}, #{item.fieldUserName}, #{item.fieldLoginName},
            #{item.fieldModule}, #{item.fieldAction}, #{item.fieldBusinessId}, #{item.fieldBefore}, #{item.fieldAfter},
            #{item.fieldRemark}, #{item.fieldIp}, #{item.fieldUserAgent}, #{item.fieldResult}, #{item.fieldFailReason},
            #{item.fieldOperateTime}
            )
        </foreach>
    </insert>

    <select id="selectById" parameterType="string" resultMap="SysLogOperationResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_log_operation
        WHERE field_id = #{fieldId}
    </select>

    <select id="selectList" resultMap="SysLogOperationResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_log_operation
        <include refid="LogWhere"/>
        ORDER BY field_operate_time DESC
        <if test="pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 分页查询日志（后台日志管理）：按操作时间排序，方向白名单（asc / desc） -->
    <select id="selectLogList" resultMap="SysLogOperationResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_log_operation
        <include refid="LogWhere"/>
        ORDER BY field_operate_time
        <choose>
            <when test="sortOrder == 'asc'">ASC</when>
            <otherwise>DESC</otherwise>
        </choose>
        <if test="pages.needPage">
            <bind name="offset" value="(pages.pageNo - 1) * pages.pageSize"/>
            LIMIT #{pages.pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 统计日志总数（与 selectLogList 条件一致，供分页 metadata.total 使用） -->
    <select id="selectLogCount" resultType="long">
        SELECT COUNT(*)
        FROM sys_log_operation
        <include refid="LogWhere"/>
    </select>

    <!-- 轻量加载：日志无 field_name 语义，仅返回 field_id 与 field_operate_time -->
    <resultMap id="SysLogOperationLoadResultMap" type="com.eric.base.sys.log.model.SysLogOperation">
        <id column="field_id" property="fieldId"/>
        <result column="field_operate_time" property="fieldOperateTime"/>
    </resultMap>

    <select id="loadModel" parameterType="string" resultMap="SysLogOperationLoadResultMap">
        SELECT field_id, field_operate_time
        FROM sys_log_operation
        WHERE field_id = #{fieldId}
    </select>

</mapper>
